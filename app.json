{
  "expo": {
    "name": "Attendant",
    "slug": "attendant-app",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./src/assets/image/icon.png",
    "scheme": "attendantapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/image/android-icon-foreground.png",
        "backgroundImage": "./src/assets/image/android-icon-background.png",
        "monochromeImage": "./src/assets/image/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.enriquegaytan01.attendantapp"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/image/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/image/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bfc3a7b1-a5e3-4fcb-8237-082dcb2e81a4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bfc3a7b1-a5e3-4fcb-8237-082dcb2e81a4",
      "enabled" : true,
      "fallbackToCacheTimeout": 0
    }
  }
}
